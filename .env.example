# Shared password required to log in, upload, and download files.
# If omitted, defaults to "vault2026" for immediate local development.
APP_PASSWORD=your-strong-shared-password

# Vercel Blob Read/Write Token (automatically added when you connect Vercel Blob in your Vercel project)
# When omitted locally, VaultDrop automatically falls back to storing files in ./.local-vault/
BLOB_READ_WRITE_TOKEN=

# Optional custom secret for signing HMAC-SHA256 session cookies
SESSION_SECRET=
