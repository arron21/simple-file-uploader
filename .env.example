# Shared password required to log in, upload, and download files.
# If omitted, defaults to "vault2026" for immediate local development.
APP_PASSWORD=your-strong-shared-password

# Vercel Blob Read/Write Token (automatically added when you connect Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Stripe Secret Key (e.g. sk_live_... or sk_test_...)
# When set, clicking any Paid Pass or Pro Unlimited plan opens real Stripe Checkout (Cards, Apple Pay, Google Pay).
# When omitted, VaultDrop runs in Interactive Sandbox Checkout Mode for testing.
STRIPE_SECRET_KEY=

# Optional owner/VIP promo code to unlock Pro Unlimited without payment
PRO_PROMO_CODE=

# Google AdSense Monetization (Optional — automatically loads AdSense & serves /ads.txt when set)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
NEXT_PUBLIC_ADSENSE_INTERSTITIAL_SLOT=
ADS_TXT_CONTENT=

# Optional Direct Sponsor "Advertise Here" Inquiry URL or mailto:
NEXT_PUBLIC_SPONSOR_INQUIRY_URL=mailto:sponsors@yourdomain.com

# Optional secrets for signing cookies & securing /api/cron/cleanup
SESSION_SECRET=
ENTITLEMENT_SECRET=
CRON_SECRET=
